<?xml version="1.0"?>
<!--
  delivery_bot.urdf.xacro

  Geometry only: no inertials, no wheel joint states (wheel joints are fixed
  until encoders or real joint control exist).

  Every length is in metres and every MEASURE value is a PLACEHOLDER.
  Replace the placeholder, delete the MEASURE marker only once it has been
  measured with a tape measure on the actual robot.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delivery_bot">

  <!-- ============ dimensions (MEASURE unless stated) ============ -->
  <xacro:property name="wheel_base"   value="0.13"/>    <!-- MEASURE: left tyre centre -> right tyre centre -->
  <xacro:property name="wheel_radius" value="0.0325"/> <!-- MEASURE: nominal 65 mm wheel diameter -->
  <xacro:property name="robot_radius" value="0.10"/>   <!-- MEASURE: centre -> furthest point (costmap inflation) -->

  <xacro:property name="laser_x"   value="0.0"/>  <!-- MEASURE: lidar centre relative to base_link -->
  <xacro:property name="laser_y"   value="0.0"/>  <!-- MEASURE: use the 50 cm box test to find laser_yaw -->
  <xacro:property name="laser_z"   value="0.15"/> <!-- MEASURE: lidar scan plane height -->
  <xacro:property name="laser_yaw" value="0.0"/>  <!-- MEASURE: deg -> rad, 50 cm box test -->

  <xacro:property name="imu_x" value="0.0"/>  <!-- MEASURE -->
  <xacro:property name="imu_y" value="0.0"/>  <!-- MEASURE -->
  <xacro:property name="imu_z" value="0.05"/> <!-- MEASURE -->

  <!-- body dimensions are cosmetic only (Foxglove 3D view) -->
  <xacro:property name="body_radius" value="${robot_radius}"/>
  <xacro:property name="body_height" value="0.08"/>

  <material name="grey">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.20 0.45 0.85 1.0"/>
  </material>

  <!-- ============ base_footprint: on the floor, between the wheels ============ -->
  <link name="base_footprint"/>

  <!-- ============ base_link: body centre, wheel_radius above the floor ============ -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height / 2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${body_radius}" length="${body_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- ============ laser (RPLidar A1M8) ============ -->
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- z is relative to base_link; subtract wheel_radius when measuring from the floor -->
    <origin xyz="${laser_x} ${laser_y} ${laser_z - wheel_radius}" rpy="0 0 ${laser_yaw}"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="dark"/>
    </visual>
  </link>

  <!-- ============ imu_link (MPU6050 / GY-521) ============ -->
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

</robot>
