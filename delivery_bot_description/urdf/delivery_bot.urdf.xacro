<?xml version="1.0"?>
<!--
  delivery_bot.urdf.xacro

  Geometry only: no inertials, no wheel joint states (wheel joints are fixed
  until encoders or real joint control exist).

  Every length is in metres and every MEASURE value is a PLACEHOLDER.
  Replace the placeholder, delete the MEASURE marker only once it has been
  measured with a tape measure on the actual robot.

  Frames the rest of the stack assumes:

    base_footprint          on the floor, between the wheels, no visual
      └── base_link         body origin, one wheel_radius above the floor
            ├── laser       RPLidar A1M8, scan plane height + yaw from the
            │               50 cm box test
            └── imu_link    MPU6050, rigid to the body

  Rules:
    * base_footprint is published by the EKF, not here — this file must only
      describe base_link and below.
    * xacro: a plain URDF will not expand; keep the xmlns:xacro attribute.

  TODO: xacro:property for wheel_base, wheel_radius, robot_radius, laser_xyz,
  laser_yaw, imu_xyz; then the two fixed joints and the three visuals.
  `xacro delivery_bot.urdf.xacro` must exit 0 and mention base_link, laser and
  imu_link when it is done.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="delivery_bot">
</robot>
