<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delivery_bot_drivers</name>
  <version>0.1.0</version>
  <description>Hardware nodes: L298N motor driver and MPU6050 IMU.</description>
  <maintainer email="samwee24@users.noreply.github.com">delivery_bot team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <!-- GPIO and I2C libraries come from apt on the Pi:
       python3-smbus2, python3-gpiozero, python3-lgpio.
       rosdep has no keys for them on Ubuntu 24.04, so they are listed in
       README.md instead of here (see "Deviations"). -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
