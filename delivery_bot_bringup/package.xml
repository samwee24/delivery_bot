<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delivery_bot_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration: lidar, base stack, mapping, navigation.</description>
  <maintainer email="samwee24@users.noreply.github.com">delivery_bot team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>delivery_bot_description</exec_depend>
  <exec_depend>delivery_bot_drivers</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>rf2o_laser_odometry</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
